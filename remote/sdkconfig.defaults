# Pins this app's role for InfluxDB tagging (see components/common/inc/node_config.h).
CONFIG_SIGGECA_NODE_ROLE_REMOTE=y

# OTA over LoRa (see partitions.csv, ota_lora_node.h). Rollback is what keeps a
# bad image from leaving the node unreachable: a new image that can't reach the
# gateway goes back to the previous one (remote_fsm.c).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
